# Production mode used by the RainYun systemd service.
NODE_ENV=production

# PostgreSQL connection string for the persistent database.
PGDATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# Uploaded files are saved at public/uploads and are served as /uploads/<file>.

# Random server-only secret used to sign HTTP-only login sessions.
AUTH_SESSION_SECRET=replace-with-a-long-random-secret

# Optional: set true/false to override the cookie Secure flag. If omitted,
# the server follows the actual request protocol: HTTP for an IP-only deploy,
# HTTPS when a TLS proxy or domain is configured.
# AUTH_COOKIE_SECURE=false

# 通知邮件（可选）。用 QQ 邮箱的免费 SMTP：SMTP_PASS 是授权码，不是登录密码。
# 不配置时系统只发站内通知，不影响任何业务功能。
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=465
# SMTP_USER=123456789@qq.com
# SMTP_PASS=your-smtp-authorization-code
# MAIL_FROM=123456789@qq.com
