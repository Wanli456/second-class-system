# PostgreSQL connection string for the persistent cloud database.
PGDATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# Supabase project values used for public file uploads.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
SUPABASE_STORAGE_BUCKET=app-files

# Random server-only secret used to sign HTTP-only login sessions.
AUTH_SESSION_SECRET=replace-with-a-long-random-secret

