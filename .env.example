# PostgreSQL connection string for the persistent cloud database.
PGDATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# Coze-managed Supabase-compatible storage values are injected automatically
# in Coze deployments. These generic names are only needed for local/legacy use.
COZE_SUPABASE_URL=https://your-coze-storage.supabase.co
COZE_SUPABASE_SERVICE_ROLE_KEY=replace-with-coze-service-role-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
SUPABASE_STORAGE_BUCKET=app-files

# Random server-only secret used to sign HTTP-only login sessions.
AUTH_SESSION_SECRET=replace-with-a-long-random-secret
